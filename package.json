{
  "name": "@snailuu/notra",
  "description": "LLM Wiki For Code",
  "version": "0.1.2",
  "type": "module",
  "bin": {
    "notra": "./bin/notra.mjs"
  },
  "files": [
    "bin/",
    "dist/",
    "plugins/notra/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "pnpm build:ts && pnpm build:graph",
    "build:graph": "node knowledge/tools/build-graph-data.mjs",
    "build:ts": "node scripts/clean-dist.mjs && tsc -p tsconfig.json && node scripts/build-plugin-scripts.mjs",
    "codex:install": "pnpm build:ts && node dist/core/platform/codex-local.js",
    "codex:uninstall": "pnpm build:ts && node dist/core/platform/codex-local.js uninstall",
    "prepack": "pnpm build:ts",
    "publish": "npm publish",
    "audit:security": "pnpm audit --audit-level moderate --registry https://registry.npmjs.org",
    "check": "pnpm typecheck && pnpm test && pnpm audit:security",
    "typecheck": "pnpm build:ts && tsc -p tsconfig.test.json --noEmit",
    "test": "pnpm build:ts && node --experimental-test-isolation=none --test tests/*.test.ts knowledge/tests/*.test.ts",
    "serve": "node knowledge/tools/serve-knowledge.mjs"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "typescript": "^6.0.3"
  }
}
